#include <winver.h>

// The program's icon (Explorer, the taskbar, Task Manager, and the tray while
// the guard is on), and the same in grey for the tray while it is off.
1 ICON "MouseMend.ico"
2 ICON "MouseMend-off.ico"

// The tuner page, built into the exe so the program is one file.
PAGE RCDATA "..\\web\\index.html"

// What Windows shows about the program, Task Manager's startup list included.
1 VERSIONINFO
FILEVERSION 1,1,2,0
PRODUCTVERSION 1,1,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MouseMend"
            VALUE "FileDescription", "MouseMend"
            VALUE "FileVersion", "1.1.2"
            VALUE "InternalName", "MouseMend"
            VALUE "LegalCopyright", "MIT license"
            VALUE "OriginalFilename", "MouseMend.exe"
            VALUE "ProductName", "MouseMend"
            VALUE "ProductVersion", "1.1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
